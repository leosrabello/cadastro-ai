# CadastroAI — production settings for the company server. Copy to .env and fill in.

# Name employees' computers use to reach the server, e.g. cadastro.fintrust.local
CADASTRO_HOST=

# HTTPS certificate. With the company's certificate, put cert.pem and key.pem in ./tls and use:
#   TLS_DIRECTIVE=tls /etc/caddy/tls/cert.pem /etc/caddy/tls/key.pem
# "tls internal" makes Caddy issue its own certificate; computers must then trust Caddy's root
# certificate (exported from the caddy_data volume) through group policy.
TLS_DIRECTIVE=tls internal
TLS_DIR=./tls

# Shared folder mounted on this server for the watcher (see docs/deployment.md)
WATCH_FOLDER=/srv/cadastro-share

POSTGRES_PASSWORD=
JWT_SECRET=
STORAGE_ENCRYPTION_KEY=
SESSION_HOURS=10
MAX_UPLOAD_MB=25

OCR_PROVIDER=tesseract
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
AI_MODEL=claude-opus-5-5
AI_ALLOW_IMAGES=false

CORS_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
