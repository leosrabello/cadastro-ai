# Cadastro AI — server configuration. Copy to .env and fill in. Never commit .env.
# Secrets below live only on the server; the desktop app never receives any of them.

APP_ENV=development

# PostgreSQL password used by docker-compose (and in DATABASE_URL for non-compose deployments).
POSTGRES_PASSWORD=
# DATABASE_URL=postgresql+psycopg://cadastro:<password>@<host>:5432/cadastro

# Session signing key, at least 32 random characters:  openssl rand -hex 32
JWT_SECRET=
SESSION_HOURS=10

# Document encryption key (Fernet). Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes every stored document unreadable. Keep it in the vault and in the backup plan.
STORAGE_ENCRYPTION_KEY=

MAX_UPLOAD_MB=25
MAX_PAGES=15

# OCR: "tesseract" (self-hosted, default) or "azure" (Azure AI Document Intelligence).
OCR_PROVIDER=tesseract
TESSERACT_LANG=por
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# AI-assisted analysis: "none" (default) or "anthropic". Also switch it on in Settings > Processamento.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_SECONDS=120
# Server-side ceiling: page images are never sent to the AI provider unless this is true
# AND the administrator also enables it in Settings.
AI_ALLOW_IMAGES=false

# Comma-separated roots the folder watcher may be pointed at from Settings.
WATCH_ALLOWED_ROOTS=/watch

# Origins allowed to call the API (the Tauri app and the local dev server).
CORS_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost,http://localhost:1420

# First administrator, created only when no administrator exists. Remove after first login.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
